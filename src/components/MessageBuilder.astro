---
import { TEMPLATES, type Values } from '../lib/templates';

interface Props {
  kind: keyof typeof TEMPLATES;
}
const { kind } = Astro.props;
const t = TEMPLATES[kind];
const v: Values = { ...t.defaults };
const initial = t.compose(v);
const id = (name: string) => `${kind}-${name}`;
---
<div class="builder" data-builder={kind}>
  <form class="builder-form" onsubmit="return false">
    {t.fields.map((f) => {
      if (f.type === 'radio') {
        return (
          <fieldset class="row">
            <legend>{f.label}</legend>
            {f.options!.map((o) => (
              <label class="inline">
                <input type="radio" name={f.name} value={o.value} checked={v[f.name] === o.value} /> {o.label}
              </label>
            ))}
          </fieldset>
        );
      }
      const spec = f.dynamic ? f.dynamic(v) : { label: f.label, placeholder: f.placeholder ?? '' };
      const hintId = f.hint ? `${id(f.name)}-hint` : undefined;
      return (
        <div class="field" data-field={f.name} hidden={spec === null}>
          <label for={id(f.name)}>
            <span data-label>{spec?.label ?? f.label}</span>
            {f.tag && <span class={f.tag === 'required' ? 'req' : 'opt'}> ({f.tag})</span>}
          </label>
          {f.hint && <p class="hint" id={hintId}>{f.hint}</p>}
          {f.type === 'select' ? (
            <select id={id(f.name)} name={f.name}>
              {f.options!.map((o) => (
                <option value={o.value} selected={v[f.name] === o.value}>{o.label}</option>
              ))}
            </select>
          ) : (
            <input id={id(f.name)} name={f.name} type="text" autocomplete="off"
              placeholder={spec?.placeholder ?? ''} aria-describedby={hintId} />
          )}
        </div>
      );
    })}
  </form>

  <div class="builder-preview">
    <label for={id('output')}>Preview</label>
    <textarea id={id('output')} readonly rows="16">{initial}</textarea>
    <p class="warn" data-warn role="status"></p>
    <div class="builder-actions">
      <button type="button" data-copy hidden>Copy message</button>
      <span class="meta" data-count aria-live="polite"></span>
    </div>
    <noscript><p class="hint">The live preview needs JavaScript. Use the template above and fill in the brackets yourself.</p></noscript>
    <p class="hint">Nothing you type is sent or stored. It disappears when you leave the page.</p>
  </div>
</div>

<script>
  import { TEMPLATES, wordCount, type Values } from '../lib/templates';

  document.querySelectorAll<HTMLElement>('[data-builder]').forEach((root) => {
    const t = TEMPLATES[root.dataset.builder!];
    if (!t) return;
    const form = root.querySelector('form')!;
    const output = root.querySelector<HTMLTextAreaElement>('textarea')!;
    const warn = root.querySelector<HTMLElement>('[data-warn]')!;
    const count = root.querySelector<HTMLElement>('[data-count]')!;
    const copy = root.querySelector<HTMLButtonElement>('[data-copy]')!;
    copy.hidden = false;

    const read = (): Values => {
      const d = new FormData(form);
      const v: Values = {};
      t.fields.forEach((f) => (v[f.name] = String(d.get(f.name) ?? '')));
      return v;
    };

    const render = () => {
      const v = read();
      t.fields.filter((f) => f.dynamic).forEach((f) => {
        const wrap = root.querySelector<HTMLElement>(`[data-field="${f.name}"]`)!;
        const spec = f.dynamic!(v);
        wrap.hidden = !spec;
        if (spec) {
          wrap.querySelector('[data-label]')!.textContent = spec.label;
          wrap.querySelector('input')!.placeholder = spec.placeholder;
        }
      });
      const text = t.compose(v);
      output.value = text;
      count.textContent = `${wordCount(text)} words`;
      warn.textContent = t.warnings(v).join(' ');
    };

    // Clear dependent fields when the choice they depend on changes.
    t.fields.filter((f) => f.resetWhen).forEach((f) => {
      form.elements.namedItem(f.resetWhen!)?.addEventListener?.('change', () => {
        (form.elements.namedItem(f.name) as HTMLInputElement).value = '';
      });
    });

    form.addEventListener('input', render);
    form.addEventListener('change', render);

    copy.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(output.value);
        copy.textContent = 'Copied';
      } catch {
        output.select();
        copy.textContent = 'Press Ctrl+C / Cmd+C to copy';
      }
      setTimeout(() => (copy.textContent = 'Copy message'), 2500);
    });

    render();
  });
</script>
